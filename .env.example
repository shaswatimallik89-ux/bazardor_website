# Copy this file to .env.local and fill in the values.

# Required. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Public URL of the app (no trailing slash).
# Local: http://localhost:3000   Production: your deployed URL
BETTER_AUTH_URL=http://localhost:3000

# Optional. Path of the SQLite file (default: ./database.sqlite).
# Must live on a persistent disk in production.
DATABASE_PATH=./database.sqlite

# Optional. Postgres connection string. When set it is used INSTEAD of SQLite.
# Required on Vercel/serverless hosts (e.g. a free Neon or Supabase database).
DATABASE_URL=

# Optional. Google OAuth (leave empty to disable the Google button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. GitHub OAuth (leave empty to disable the GitHub button).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
